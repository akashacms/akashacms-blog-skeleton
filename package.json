{
  "author": {
    "name": "David Herron",
    "email": "david@davidherron.com",
    "url": "http://davidherron.com"
  },
  "name": "akashacms-blog-skeleton",
  "description": "AkashaCMS blog/podcast skeleton website",
  "version": "0.10.0",
  "main": "config.mjs",
  "scripts": {
    "clean": "rm -rf out/* && mkdir -p out",
    "build": "npm-run-all clean build:copy build:site",
    "build:copy": "akasharender copy-assets config.mjs",
    "build:site": "akasharender render config.mjs",
    "test": "cd test && mocha ./index",
    "preview": "live-server out"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/akashacms/akashacms-blog-skeleton.git"
  },
  "dependencies": {
    "@akashacms/plugins-base": "akashacms/akashacms-base#0.10",
    "@akashacms/plugins-blog-podcast": "akashacms/akashacms-blog-podcast#0.10",
    "@akashacms/plugins-booknav": "akashacms/akashacms-booknav#0.10",
    "@akashacms/plugins-breadcrumbs": "akashacms/akashacms-breadcrumbs#0.10",
    "@akashacms/plugins-embeddables": "akashacms/akashacms-embeddables#0.10",
    "@akashacms/theme-bootstrap": "akashacms/akashacms-theme-bootstrap#5.x",
    "@compodoc/live-server": "^1.2.x",
    "akasharender": "akashacms/akasharender#0.10",
    "chai": "^4.1.2",
    "mocha": "^5.2.0",
    "npm-run-all": "^4.1.5"
  }
}
