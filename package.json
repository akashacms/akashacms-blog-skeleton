{
  "author": {
    "name": "David Herron",
    "email": "david@davidherron.com",
    "url": "http://davidherron.com"
  },
  "name": "akashacms-blog-skeleton",
  "description": "AkashaCMS blog/podcast skeleton website",
  "version": "0.7.6",
  "main": "config.js",
  "scripts": {
    "clean": "rm -rf out/* && mkdir -p out",
    "build": "npm-run-all clean build:copy build:site",
    "build:copy": "akasharender copy-assets config.mjs",
    "build:site": "akasharender render config.mjs",
    "pretest": "npm run build",
    "test": "cd test && mocha ./index",
    "watch": "npm-run-all --parallel watcher preview",
    "watcher": "akasharender watch config.mjs",
    "preview": "live-server out"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/akashacms/akashacms-blog-skeleton.git"
  },
  "dependencies": {
    "@akashacms/plugins-base": "akashacms/akashacms-base#0.9",
    "@akashacms/plugins-blog-podcast": "akashacms/akashacms-blog-podcast#0.9",
    "@akashacms/plugins-booknav": "akashacms/akashacms-booknav#0.9",
    "@akashacms/plugins-breadcrumbs": "akashacms/akashacms-breadcrumbs#",
    "@akashacms/plugins-embeddables": "akashacms/akashacms-embeddables#0.9",
    "@akashacms/theme-bootstrap": "akashacms/akashacms-theme-bootstrap",
    "@compodoc/live-server": "^1.2.3",
    "akasharender": "../akasharender",
    "bootstrap": "^4.x",
    "chai": "^4.1.2",
    "html-minifier": "^3.1.1",
    "local-web-server": "^3.0.7",
    "mocha": "^5.2.0",
    "npm-run-all": "^4.1.5",
    "oembed": "^0.1.0"
  }
}
